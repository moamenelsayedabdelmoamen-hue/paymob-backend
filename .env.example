# Copy to .env locally. Never commit actual credentials.
PORT=3000
NODE_ENV=development

# Paymob credentials (move any credentials hardcoded in older versions into these variables).
PAYMOB_API_KEY=replace_with_rotated_paymob_api_key
PAYMOB_HMAC_SECRET=replace_with_paymob_hmac_secret
CARD_INTEGRATION_ID=replace_with_card_integration_id
WALLET_INTEGRATION_ID=replace_with_wallet_integration_id
CARD_IFRAME_ID=replace_with_card_iframe_id

# Firebase Realtime Database.
FIREBASE_DATABASE_URL=https://el-batal-express-956ae-default-rtdb.firebaseio.com
# Base64-encoded contents of the Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_BASE64=replace_with_base64_service_account_json
